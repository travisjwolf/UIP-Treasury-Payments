  "variables": {
    "globals": [
      {
        "id": "payment_case",
        "direction": "in",
        "type": "object",
        "defaultValue": {},
        "description": "Typed PaymentCase supplied at intake.",
        "triggerNodeId": "start"
      },
      {
        "id": "gate_context",
        "direction": "in",
        "type": "object",
        "defaultValue": {},
        "description": "Typed deterministic gate context supplied at intake.",
        "triggerNodeId": "start"
      },
      {
        "id": "policy_config",
        "direction": "in",
        "type": "object",
        "defaultValue": {},
        "description": "Per-customer G3/G5/G8/G10 thresholds supplied by the policy store.",
        "triggerNodeId": "start"
      },
      {
        "id": "demo_role",
        "direction": "in",
        "type": "string",
        "defaultValue": "",
        "description": "Optional synthetic role passed to the read-only repair agent.",
        "triggerNodeId": "start"
      },
      {
        "id": "reviewedProposedValue",
        "direction": "inout",
        "type": "string",
        "defaultValue": "",
        "description": "Proposed value returned by the human review task."
      }
    ],
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
        "id": "repairAgent.output",
        "type": "object",
        "schema": {
          "type": "object",
          "properties": {
            "outcome": {
              "description": "Closed-set repair outcome returned to orchestration.",
              "enum": [
                "RESOLVED",
                "RESOLVED_LOW_CONFIDENCE",
                "AMBIGUOUS",
                "NEEDS_INFO",
                "EXHAUSTED",
                "BLOCKED_POLICY"
              ],
              "title": "Outcome",
              "type": "string"
            },
            "proposed_action": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "description": "Payment field that the agent proposes changing.",
                      "enum": [
                        "amount_usd",
                        "beneficiary_account",
                        "beneficiary_bank_aba",
                        "beneficiary_name",
                        "currency",
                        "customer_name",
                        "remittance_info"
                      ],
                      "title": "Field",
                      "type": "string"
                    },
                    "current_value": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "description": "Value currently present on the payment.",
                      "title": "Current Value"
                    },
                    "proposed_value": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "description": "Replacement value copied from cited read-only evidence.",
                      "title": "Proposed Value"
                    }
                  },
                  "required": [
                    "field",
                    "current_value",
                    "proposed_value"
                  ],
                  "title": "ProposedActionOutput",
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Evidence-backed repair proposal, or null when none is supportable.",
              "type": "any"
            },
            "confidence": {
              "description": "Confidence in the proposed repair, between zero and one.",
              "maximum": 1,
              "minimum": 0,
              "title": "Confidence",
              "type": "number"
            },
            "evidence": {
              "description": "Cumulative read-only evidence trace supporting the result.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "case_id": {
                    "description": "Wire-repair case identifier for this evidence.",
                    "minLength": 1,
                    "title": "Case Id",
                    "type": "string"
                  },
                  "type": {
                    "description": "Closed evidence category produced by a read-only source.",
                    "enum": [
                      "lookup",
                      "history_match",
                      "sanctions",
                      "document",
                      "call_transcript"
                    ],
                    "title": "Type",
                    "type": "string"
                  },
                  "source": {
                    "description": "Read-only source URI that produced the evidence.",
                    "minLength": 1,
                    "title": "Source",
                    "type": "string"
                  },
                  "content": {
                    "anyOf": [
                      {
                        "additionalProperties": true,
                        "type": "object"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "description": "Canonical payload returned by the evidence source.",
                    "title": "Content"
                  },
                  "produced_by": {
                    "description": "Read-only tool that produced this record.",
                    "minLength": 1,
                    "title": "Produced By",
                    "type": "string"
                  },
                  "timestamp": {
                    "description": "ISO-8601 timestamp assigned to the evidence.",
                    "format": "date-time",
                    "title": "Timestamp",
                    "type": "string"
                  }
                },
                "required": [
                  "case_id",
                  "type",
                  "source",
                  "content",
                  "produced_by",
                  "timestamp"
                ],
                "title": "EvidenceOutput",
                "type": "object"
              },
              "title": "Evidence",
              "type": "array"
            },
            "reasoning_summary": {
              "description": "Concise explanation of the evidence and control boundary.",
              "title": "Reasoning Summary",
              "type": "string"
            },
            "tools_called": {
              "description": "Read-only tools called, in execution order.",
              "items": {
                "type": "string"
              },
              "title": "Tools Called",
              "type": "array"
            }
          }
        },
        "binding": {
          "nodeId": "repairAgent",
          "outputId": "output"
        }
      },
      {
        "id": "repairAgent.error",
        "type": "object",
        "description": "Error information if the node fails",
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "required": [
            "code",
            "message",
            "detail",
            "category",
            "status"
          ],
          "properties": {
            "code": {
              "type": "string",
              "description": "Error code as a string"
            },
            "message": {
              "type": "string",
              "description": "High-level error message"
            },
            "detail": {
              "type": "string",
              "description": "Detailed error description"
            },
            "category": {
              "type": "string",
              "description": "Error category"
            },
            "status": {
              "type": "integer",
              "description": "HTTP status code"
            }
          },
          "additionalProperties": false
        },
        "binding": {
          "nodeId": "repairAgent",
          "outputId": "error"
        }
