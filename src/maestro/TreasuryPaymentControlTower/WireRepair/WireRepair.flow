{
  "id": "827e249b-d372-4aad-b8d7-962c817e5b5f",
  "version": "1.8",
  "name": "WireRepair",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Intake payment"
      },
      "inputs": {
        "entryPointId": "6e82a367-ac19-4fb6-8257-c93c3db5daad",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "repairAgent",
      "type": "uipath.core.agent.ee894252-e868-4de2-a8b2-2b29ba8efd07",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Bravo repair agent",
        "icon": "coded-agent"
      },
      "inputs": {
        "payment_case": "=js:$vars.start.output.payment_case",
        "gate_context": "=js:$vars.start.output.gate_context",
        "demo_role": "=js:$vars.start.output.demo_role"
      }
    },
    {
      "id": "policyGate",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Deterministic policy gate"
      },
      "inputs": {
        "script": "const payment = $vars.start.output.payment_case; const context = $vars.start.output.gate_context; const config = $vars.start.output.policy_config; const agent = $vars.repairAgent.output; if (!payment || !context || !config || !agent) { throw new Error(\"PaymentCase, GateContext, PolicyConfig, and AgentOutput are required.\"); } if (config.customer_id !== payment.customer_id) { throw new Error(\"PolicyConfig.customer_id must match PaymentCase.customer_id\"); } const decide = (gate, result, reason) => ({ case_id: payment.case_id, gate, result, reason, evaluated_at: context.evaluated_at }); if (context.sanctions_status !== \"clear\") return decide(\"G0\", \"COMPLIANCE_REFERRAL\", \"G0 sanctions status is not clear.\"); const proposal = agent.proposed_action; if (proposal) { if (proposal.field === \"beneficiary_account\") return decide(\"G1\", \"HUMAN_APPROVAL\", \"G1 proposed repair changes the beneficiary account.\"); if ([\"amount_usd\", \"currency\"].includes(proposal.field)) return decide(\"G2\", \"HARD_STOP\", \"G2 proposed repair changes an amount or currency field.\"); if (payment.amount_usd > config.auto_apply_amount_threshold_usd) return decide(\"G3\", \"HUMAN_APPROVAL\", \"G3 payment amount exceeds the auto-apply threshold.\"); if (context.first_time_counterparty) return decide(\"G4\", \"HUMAN_APPROVAL\", \"G4 counterparty has no established payment history.\"); if (agent.confidence < config.minimum_confidence) return decide(\"G5\", \"HUMAN_APPROVAL\", \"G5 proposal confidence is below the configured minimum.\"); if (context.cross_border || payment.currency !== \"USD\") return decide(\"G6\", \"HUMAN_APPROVAL\", \"G6 payment is cross-border or denominated outside USD.\"); if (payment.exception_code === \"EX-07\") return decide(\"G7\", \"HUMAN_APPROVAL\", \"G7 payment is marked as a duplicate suspect.\"); if (context.same_day_beneficiary_total_usd > config.same_day_beneficiary_velocity_threshold_usd) return decide(\"G8\", \"HUMAN_APPROVAL\", \"G8 beneficiary same-day value exceeds the velocity threshold.\"); } if (agent.outcome === \"NEEDS_INFO\") return decide(\"G9\", \"CALLBACK_THEN_HUMAN\", \"G9 agent needs additional information before a repair can proceed.\"); if ([\"AMBIGUOUS\", \"EXHAUSTED\"].includes(agent.outcome)) return decide(\"G9\", \"ESCALATE\", \"G9 agent outcome requires escalation with its full trace.\"); if ((new Date(context.cutoff_at).getTime() - new Date(context.evaluated_at).getTime()) < config.cutoff_escalation_minutes * 60000) return decide(\"G10\", \"PRIORITY_ESCALATION\", \"G10 remaining cutoff time is inside the priority escalation window.\"); if (agent.outcome === \"BLOCKED_POLICY\") return decide(null, \"ESCALATE\", \"Agent reported a policy block not explained by an earlier deterministic gate.\"); return decide(null, \"AUTO_APPLY\", \"No deterministic policy gate fired; the repair is eligible for auto-apply.\");"
      }
    },
    {
      "id": "routeDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Auto-apply eligible?"
      },
      "inputs": {
        "expression": "$vars.policyGate.output.result === \"AUTO_APPLY\"",
        "trueLabel": "Authorized sandbox effect",
        "falseLabel": "Human or terminal policy path"
      }
    },
    {
      "id": "autoEffect",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Record authorized sandbox effect"
      },
      "inputs": {
        "script": "const payment = $vars.start.output.payment_case; const proposal = $vars.repairAgent.output.proposed_action; const evidence = $vars.repairAgent.output.evidence; const decision = $vars.policyGate.output; if (decision.result !== \"AUTO_APPLY\" || !proposal) throw new Error(\"Deterministic AUTO_APPLY authorization and a proposal are required.\"); if ([\"beneficiary_account\", \"amount_usd\", \"currency\"].includes(proposal.field)) throw new Error(\"The proposed field is not eligible for autonomous application.\"); if (payment[proposal.field] !== proposal.current_value) throw new Error(\"Proposal current_value does not match the payment record.\"); if (evidence.some((item) => item.case_id !== payment.case_id)) throw new Error(\"Evidence case_id must match the payment record.\"); const content = (item) => { if (typeof item.content !== \"string\") return item.content; try { return JSON.parse(item.content); } catch { return item.content; } }; const contains = (value, expected) => value === expected || (Array.isArray(value) && value.some((item) => contains(item, expected))) || (value && typeof value === \"object\" && Object.values(value).some((item) => contains(item, expected))); if (!evidence.some((item) => contains(content(item), proposal.proposed_value))) throw new Error(\"Proposed value must be traceable to evidence.\"); return { case_id: payment.case_id, status: \"RECORDED\", audit: { field: proposal.field, before: proposal.current_value, after: proposal.proposed_value, credential_identity: \"sandbox://wire-repair-effector\", authorization_mode: \"auto_apply\", authorized_by: \"deterministic-policy-gate\", gate: decision.gate || \"NONE\", recorded_at: $vars.start.output.gate_context.evaluated_at, payment_write_performed: false } };"
      }
    },
    {
      "id": "autoLedger",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Append auto-apply ledger"
      },
      "inputs": {
        "script": "return { case_id: $vars.start.output.payment_case.case_id, transitions: [\"INTAKE_RECEIVED\", \"AGENT_INVESTIGATION_STARTED\", \"AGENT_PROPOSED\", \"GATE_EVALUATED\", \"AUTO_APPLY_AUTHORIZED\", \"EFFECT_RECORDED\", \"CASE_STATE_UPDATED\"], effect: $vars.autoEffect.output, payment_write_performed: false };"
      }
    },
    {
      "id": "humanTaskEligible",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "In-app human task permitted?"
      },
      "inputs": {
        "expression": "[\"HUMAN_APPROVAL\", \"CALLBACK_THEN_HUMAN\", \"PRIORITY_ESCALATION\", \"ESCALATE\"].includes($vars.policyGate.output.result)",
        "trueLabel": "Create human task",
        "falseLabel": "Non-overridable terminal path"
      }
    },
    {
      "id": "terminalLedger",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Append terminal policy ledger"
      },
      "inputs": {
        "script": "const decision = $vars.policyGate.output; const terminal = decision.result === \"COMPLIANCE_REFERRAL\" ? \"COMPLIANCE_REFERRAL_CREATED\" : \"POLICY_HARD_STOP_RECORDED\"; return { case_id: $vars.start.output.payment_case.case_id, transitions: [\"INTAKE_RECEIVED\", \"AGENT_INVESTIGATION_STARTED\", \"AGENT_PROPOSED\", \"GATE_EVALUATED\", \"AUTONOMY_REFUSED\", terminal, \"CASE_STATE_UPDATED\"], gate: decision.gate, reason: decision.reason, overridable_in_app: false, payment_write_performed: false };"
      }
    },
    {
      "id": "escalationPacket",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Build exact escalation packet"
      },
      "inputs": {
        "script": "const payment = $vars.start.output.payment_case; const agent = $vars.repairAgent.output; const decision = $vars.policyGate.output; const callback = decision.result === \"CALLBACK_THEN_HUMAN\"; return { payment, proposal: agent.proposed_action, gate: decision.gate || \"NONE\", reason: decision.reason, evidence: agent.evidence, cutoff_time: payment.cutoff_time, permitted_actions: callback ? [\"provide_info\", \"approve\", \"reject\", \"escalate\"] : [\"approve\", \"edit\", \"reject\", \"escalate\"] };"
      }
    },
    {
      "id": "taskProjection",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Project readable task fields"
      },
      "inputs": {
        "script": "const packet = $vars.escalationPacket.output; const payment = packet.payment; const proposal = packet.proposal; return { payment: `${payment.case_id} | ${payment.customer_name} | ${payment.amount_usd} ${payment.currency} | ${payment.beneficiary_name} | account ${payment.beneficiary_account}`, proposalField: proposal ? proposal.field : \"No proposed field\", currentValue: proposal ? String(proposal.current_value) : \"\", proposedValue: proposal ? String(proposal.proposed_value) : \"\", gate: packet.gate, reason: packet.reason, evidence: JSON.stringify(packet.evidence, null, 2), cutoff: packet.cutoff_time, permittedActions: packet.permitted_actions.join(\", \") };"
      }
    },
    {
      "id": "humanEscalation",
      "type": "uipath.human-in-the-loop",
      "typeVersion": "1.0",
      "display": {
        "label": "Wire repair approval"
      },
      "inputs": {
        "type": "quick",
        "title": "Wire repair approval",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "High",
        "schema": {
          "schemaId": "5a406b2e-cd6e-4aac-b1ee-b360928a0fc2",
          "fields": [
            {
              "id": "payment",
              "label": "Payment",
              "type": "text",
              "direction": "input",
              "binding": "vars.taskProjection.output.payment"
            },
            {
              "id": "proposalfield",
              "label": "Proposed Field",
              "type": "text",
              "direction": "input",
              "binding": "vars.taskProjection.output.proposalField"
            },
            {
              "id": "currentvalue",
              "label": "Current Value",
              "type": "text",
              "direction": "input",
              "binding": "vars.taskProjection.output.currentValue"
            },
            {
              "id": "proposedvalue",
              "label": "Proposed Value",
              "type": "text",
              "direction": "inOut",
              "binding": "vars.taskProjection.output.proposedValue",
              "variable": "reviewedProposedValue"
            },
            {
              "id": "gate",
              "label": "Deterministic Gate",
              "type": "text",
              "direction": "input",
              "binding": "vars.taskProjection.output.gate"
            },
            {
              "id": "reason",
              "label": "Why Autonomy Was Refused",
              "type": "text",
              "direction": "input",
              "binding": "vars.taskProjection.output.reason"
            },
            {
              "id": "evidence",
              "label": "Evidence Packet",
              "type": "text",
              "direction": "input",
              "binding": "vars.taskProjection.output.evidence"
            },
            {
              "id": "cutoff",
              "label": "Rail Cutoff",
              "type": "text",
              "direction": "input",
              "binding": "vars.taskProjection.output.cutoff"
            },
            {
              "id": "permittedactions",
              "label": "Permitted Actions",
              "type": "text",
              "direction": "input",
              "binding": "vars.taskProjection.output.permittedActions"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "edit",
              "name": "Edit",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            },
            {
              "id": "escalate",
              "name": "Escalate",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "proposedvalue": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Edit",
                "Reject",
                "Escalate"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Edit",
            "Reject",
            "Escalate"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "humanApprovalDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Human authorized effect?"
      },
      "inputs": {
        "expression": "[\"Approve\", \"Edit\"].includes($vars.humanEscalation.status)",
        "trueLabel": "Authorized",
        "falseLabel": "No effect"
      }
    },
    {
      "id": "humanEffect",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Record human-authorized sandbox effect"
      },
      "inputs": {
        "script": "const payment = $vars.start.output.payment_case; const original = $vars.escalationPacket.output.proposal; const evidence = $vars.escalationPacket.output.evidence; const decision = $vars.policyGate.output; const action = $vars.humanEscalation.status; if (![\"Approve\", \"Edit\"].includes(action) || !original) throw new Error(\"Human approval and an original proposal are required.\"); if ([\"G0\", \"G2\"].includes(decision.gate) || [\"amount_usd\", \"currency\"].includes(original.field)) throw new Error(\"The policy path is non-overridable.\"); if (payment[original.field] !== original.current_value) throw new Error(\"Proposal current_value does not match the payment record.\"); if (evidence.some((item) => item.case_id !== payment.case_id)) throw new Error(\"Evidence case_id must match the payment record.\"); const proposed = $vars.humanEscalation.output.proposedvalue; const content = (item) => { if (typeof item.content !== \"string\") return item.content; try { return JSON.parse(item.content); } catch { return item.content; } }; const contains = (value, expected) => value === expected || String(value) === String(expected) || (Array.isArray(value) && value.some((item) => contains(item, expected))) || (value && typeof value === \"object\" && Object.values(value).some((item) => contains(item, expected))); if (!evidence.some((item) => contains(content(item), proposed))) throw new Error(\"Edited value must remain traceable to evidence.\"); return { case_id: payment.case_id, status: \"RECORDED\", audit: { field: original.field, before: original.current_value, after: proposed, credential_identity: \"sandbox://wire-repair-effector\", authorization_mode: \"human_approval\", authorized_by: \"action-center://assigned-reviewer\", gate: decision.gate || \"NONE\", recorded_at: $vars.start.output.gate_context.evaluated_at, payment_write_performed: false } };"
      }
    },
    {
      "id": "humanEffectLedger",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Append human effect ledger"
      },
      "inputs": {
        "script": "const actionState = $vars.humanEscalation.status === \"Edit\" ? \"HUMAN_EDITED\" : \"HUMAN_APPROVED\"; return { case_id: $vars.start.output.payment_case.case_id, transitions: [\"INTAKE_RECEIVED\", \"AGENT_INVESTIGATION_STARTED\", \"AGENT_PROPOSED\", \"GATE_EVALUATED\", \"AUTONOMY_REFUSED\", \"HUMAN_ESCALATION_CREATED\", actionState, \"EFFECT_RECORDED\", \"CASE_STATE_UPDATED\"], effect: $vars.humanEffect.output, payment_write_performed: false };"
      }
    },
    {
      "id": "humanNoEffectLedger",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Append no-effect human ledger"
      },
      "inputs": {
        "script": "const state = $vars.humanEscalation.status === \"Reject\" ? \"HUMAN_REJECTED\" : \"HUMAN_ESCALATED\"; return { case_id: $vars.start.output.payment_case.case_id, transitions: [\"INTAKE_RECEIVED\", \"AGENT_INVESTIGATION_STARTED\", \"AGENT_PROPOSED\", \"GATE_EVALUATED\", \"AUTONOMY_REFUSED\", \"HUMAN_ESCALATION_CREATED\", state, \"CASE_STATE_UPDATED\"], payment_write_performed: false };"
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Complete payment case"
      },
      "inputs": {},
      "outputs": {
        "reviewedProposedValue": {
          "source": "=js:$vars.reviewedProposedValue"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge-start-agent",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "repairAgent",
      "targetPort": "input"
    },
    {
      "id": "edge-agent-gate",
      "sourceNodeId": "repairAgent",
      "sourcePort": "output",
      "targetNodeId": "policyGate",
      "targetPort": "input"
    },
    {
      "id": "edge-gate-route",
      "sourceNodeId": "policyGate",
      "sourcePort": "success",
      "targetNodeId": "routeDecision",
      "targetPort": "input"
    },
    {
      "id": "edge-route-effect",
      "sourceNodeId": "routeDecision",
      "sourcePort": "true",
      "targetNodeId": "autoEffect",
      "targetPort": "input"
    },
    {
      "id": "edge-auto-effect-ledger",
      "sourceNodeId": "autoEffect",
      "sourcePort": "success",
      "targetNodeId": "autoLedger",
      "targetPort": "input"
    },
    {
      "id": "edge-auto-ledger-end",
      "sourceNodeId": "autoLedger",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    },
    {
      "id": "edge-route-human-eligibility",
      "sourceNodeId": "routeDecision",
      "sourcePort": "false",
      "targetNodeId": "humanTaskEligible",
      "targetPort": "input"
    },
    {
      "id": "edge-eligible-terminal",
      "sourceNodeId": "humanTaskEligible",
      "sourcePort": "false",
      "targetNodeId": "terminalLedger",
      "targetPort": "input"
    },
    {
      "id": "edge-terminal-end",
      "sourceNodeId": "terminalLedger",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    },
    {
      "id": "edge-eligible-packet",
      "sourceNodeId": "humanTaskEligible",
      "sourcePort": "true",
      "targetNodeId": "escalationPacket",
      "targetPort": "input"
    },
    {
      "id": "edge-packet-projection",
      "sourceNodeId": "escalationPacket",
      "sourcePort": "success",
      "targetNodeId": "taskProjection",
      "targetPort": "input"
    },
    {
      "id": "edge-projection-human",
      "sourceNodeId": "taskProjection",
      "sourcePort": "success",
      "targetNodeId": "humanEscalation",
      "targetPort": "input"
    },
    {
      "id": "edge-human-completed-decision",
      "sourceNodeId": "humanEscalation",
      "sourcePort": "completed",
      "targetNodeId": "humanApprovalDecision",
      "targetPort": "input"
    },
    {
      "id": "edge-human-authorized-effect",
      "sourceNodeId": "humanApprovalDecision",
      "sourcePort": "true",
      "targetNodeId": "humanEffect",
      "targetPort": "input"
    },
    {
      "id": "edge-human-effect-ledger",
      "sourceNodeId": "humanEffect",
      "sourcePort": "success",
      "targetNodeId": "humanEffectLedger",
      "targetPort": "input"
    },
    {
      "id": "edge-human-effect-ledger-end",
      "sourceNodeId": "humanEffectLedger",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    },
    {
      "id": "edge-human-no-effect-ledger",
      "sourceNodeId": "humanApprovalDecision",
      "sourcePort": "false",
      "targetNodeId": "humanNoEffectLedger",
      "targetPort": "input"
    },
    {
      "id": "edge-human-no-effect-ledger-end",
      "sourceNodeId": "humanNoEffectLedger",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "uipath.core.agent.ee894252-e868-4de2-a8b2-2b29ba8efd07",
      "version": "1.0.0",
      "category": "agent",
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      },
      "description": "(In-solution) wire-repair-agent",
      "tags": [
        "in-solution",
        "local"
      ],
      "sortOrder": 505,
      "supportsErrorHandling": true,
      "display": {
        "label": "wire-repair-agent",
        "icon": "autonomous-agent"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output"
            }
          ]
        }
      ],
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "open-workflow",
              "icon": "external-link",
              "label": "Open"
            }
          ]
        }
      },
      "projectId": "f5126a0b-1836-4aa7-bd7b-0430dc7f5a08",
      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "Orchestrator.StartAgentJob",
        "version": "v2",
        "bindings": {
          "resource": "process",
          "resourceSubType": "Agent",
          "resourceKey": "ee894252-e868-4de2-a8b2-2b29ba8efd07",
          "orchestratorType": "agent",
          "values": [
            {
              "name": "name",
              "propertyAttribute": "name",
              "default": "wire-repair-agent"
            },
            {
              "name": "folderPath",
              "propertyAttribute": "folderPath",
              "default": ""
            }
          ]
        },
        "projectId": "f5126a0b-1836-4aa7-bd7b-0430dc7f5a08",
        "projectName": "wire-repair-agent",
        "context": [
          {
            "name": "name",
            "type": "string",
            "value": "<bindings.name>"
          },
          {
            "name": "folderPath",
            "type": "string",
            "value": "<bindings.folderPath>"
          },
          {
            "name": "_label",
            "type": "string",
            "value": "wire-repair-agent"
          }
        ]
      },
      "form": {
        "id": "activity-properties",
        "title": "Agent",
        "sections": [
          {
            "id": "inputs",
            "title": "Inputs",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.payment_case",
                "type": "custom",
                "component": "object-editor",
                "label": "payment_case",
                "componentProps": {
                  "schema": {
                    "additionalProperties": false,
                    "properties": {
                      "case_id": {
                        "description": "Unique wire-repair case identifier.",
                        "minLength": 1,
                        "title": "Case Id",
                        "type": "string"
                      },
                      "rail": {
                        "description": "Payment rail, such as Fedwire.",
                        "minLength": 1,
                        "title": "Rail",
                        "type": "string"
