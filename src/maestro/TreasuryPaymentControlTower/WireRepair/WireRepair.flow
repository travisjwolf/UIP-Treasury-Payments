              "type": "string",
              "description": "High-level error message"
            },
            "detail": {
              "type": "string",
              "description": "Detailed error description"
            },
            "category": {
              "type": "string",
              "description": "Error category"
            },
            "status": {
              "type": "integer",
              "description": "HTTP status code"
            }
          },
          "additionalProperties": false
        },
        "binding": {
          "nodeId": "repairAgent",
          "outputId": "error"
        }
