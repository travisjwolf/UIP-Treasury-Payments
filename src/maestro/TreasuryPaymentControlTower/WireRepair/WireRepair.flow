        "serviceType": "Actions.HITL"
      },
      "inputDefaults": {
        "type": "quick",
        "schema": {
          "fields": [],
          "outcomes": [
            {
              "id": "submit",
              "name": "Submit",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            }
