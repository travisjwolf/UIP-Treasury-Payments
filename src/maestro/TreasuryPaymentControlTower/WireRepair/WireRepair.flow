  "definitions": [
    {
      "nodeType": "uipath.core.agent.ee894252-e868-4de2-a8b2-2b29ba8efd07",
      "version": "1.0.0",
      "category": "agent",
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      },
      "description": "(In-solution) wire-repair-agent",
      "tags": [
        "in-solution",
        "local"
      ],
      "sortOrder": 505,
      "supportsErrorHandling": true,
      "display": {
        "label": "wire-repair-agent",
        "icon": "autonomous-agent"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output"
            }
          ]
        }
      ],
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "open-workflow",
              "icon": "external-link",
              "label": "Open"
            }
          ]
        }
      },
      "projectId": "f5126a0b-1836-4aa7-bd7b-0430dc7f5a08",
      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "Orchestrator.StartAgentJob",
        "version": "v2",
        "bindings": {
          "resource": "process",
          "resourceSubType": "Agent",
          "resourceKey": "ee894252-e868-4de2-a8b2-2b29ba8efd07",
          "orchestratorType": "agent",
          "values": [
            {
              "name": "name",
              "propertyAttribute": "name",
              "default": "wire-repair-agent"
            },
            {
              "name": "folderPath",
              "propertyAttribute": "folderPath",
              "default": ""
            }
          ]
        },
        "projectId": "f5126a0b-1836-4aa7-bd7b-0430dc7f5a08",
        "projectName": "wire-repair-agent",
        "context": [
          {
            "name": "name",
            "type": "string",
            "value": "<bindings.name>"
          },
          {
            "name": "folderPath",
            "type": "string",
            "value": "<bindings.folderPath>"
          },
          {
            "name": "_label",
            "type": "string",
            "value": "wire-repair-agent"
          }
        ]
      },
      "form": {
        "id": "activity-properties",
        "title": "Agent",
        "sections": [
          {
            "id": "inputs",
            "title": "Inputs",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.payment_case",
                "type": "custom",
                "component": "object-editor",
                "label": "payment_case",
                "componentProps": {
                  "schema": {
                    "additionalProperties": false,
                    "properties": {
                      "case_id": {
                        "description": "Unique wire-repair case identifier.",
                        "minLength": 1,
                        "title": "Case Id",
                        "type": "string"
                      },
                      "rail": {
                        "description": "Payment rail, such as Fedwire.",
                        "minLength": 1,
                        "title": "Rail",
                        "type": "string"
                      },
                      "direction": {
                        "description": "Inbound or outbound payment direction.",
                        "enum": [
                          "outbound",
                          "inbound"
                        ],
                        "title": "Direction",
                        "type": "string"
                      },
                      "amount_usd": {
                        "description": "Payment amount normalized to USD.",
                        "exclusiveMinimum": 0,
                        "title": "Amount Usd",
                        "type": "number"
                      },
                      "currency": {
                        "description": "Three-letter ISO currency code on the payment.",
                        "pattern": "^[A-Z]{3}$",
                        "title": "Currency",
                        "type": "string"
                      },
                      "value_date": {
                        "description": "Payment value date in YYYY-MM-DD format.",
                        "format": "date",
                        "title": "Value Date",
                        "type": "string"
                      },
                      "cutoff_time": {
                        "description": "Applicable rail cutoff time in HH:MM format.",
                        "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?$",
                        "title": "Cutoff Time",
                        "type": "string"
                      },
                      "sla_deadline": {
                        "anyOf": [
                          {
                            "format": "date-time",
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Optional processing SLA deadline."
                      },
                      "source_channel": {
                        "description": "Channel through which the wire originated.",
                        "minLength": 1,
                        "title": "Source Channel",
                        "type": "string"
                      },
                      "customer_id": {
                        "description": "Commercial customer identifier.",
                        "minLength": 1,
                        "title": "Customer Id",
                        "type": "string"
                      },
                      "customer_name": {
                        "description": "Commercial customer display name.",
                        "minLength": 1,
                        "title": "Customer Name",
                        "type": "string"
                      },
                      "beneficiary_name": {
                        "description": "Beneficiary name currently on the wire.",
                        "minLength": 1,
                        "title": "Beneficiary Name",
                        "type": "string"
                      },
                      "beneficiary_account": {
                        "description": "Beneficiary account currently on the wire.",
                        "minLength": 1,
                        "title": "Beneficiary Account",
                        "type": "string"
                      },
                      "beneficiary_bank_aba": {
                        "description": "Beneficiary bank ABA routing number.",
                        "minLength": 1,
                        "title": "Beneficiary Bank Aba",
                        "type": "string"
                      },
                      "remittance_info": {
                        "description": "Wire remittance or invoice information.",
                        "title": "Remittance Info",
                        "type": "string"
                      },
                      "exception_code": {
                        "description": "Intake exception code requiring repair.",
                        "pattern": "^EX-\\d{2}$",
                        "title": "Exception Code",
                        "type": "string"
                      },
                      "exception_type": {
                        "description": "Human-readable intake exception category.",
                        "minLength": 1,
                        "title": "Exception Type",
                        "type": "string"
                      },
                      "current_queue": {
                        "description": "Current operations queue.",
                        "minLength": 1,
                        "title": "Current Queue",
                        "type": "string"
                      },
                      "status": {
                        "description": "Current payment-processing status.",
                        "minLength": 1,
                        "title": "Status",
                        "type": "string"
                      },
                      "worked_by": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Current analyst or automation owner."
                      },
                      "confidence": {
                        "anyOf": [
                          {
                            "maximum": 1,
                            "minimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Existing repair confidence, when already calculated."
                      },
                      "proposed_action": {
                        "anyOf": [
                          {
                            "additionalProperties": false,
                            "properties": {
                              "field": {
                                "description": "Payment field that the agent proposes changing.",
                                "enum": [
                                  "amount_usd",
                                  "beneficiary_account",
                                  "beneficiary_bank_aba",
                                  "beneficiary_name",
                                  "currency",
                                  "customer_name",
                                  "remittance_info"
                                ],
                                "title": "Field",
                                "type": "string"
                              },
                              "current_value": {
                                "anyOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "integer"
                                  },
                                  {
                                    "type": "number"
                                  }
                                ],
                                "description": "Value currently present on the payment.",
                                "title": "Current Value"
                              },
                              "proposed_value": {
                                "anyOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "integer"
                                  },
                                  {
                                    "type": "number"
                                  }
                                ],
                                "description": "Replacement value copied from cited read-only evidence.",
                                "title": "Proposed Value"
                              }
                            },
                            "required": [
                              "field",
                              "current_value",
                              "proposed_value"
                            ],
                            "title": "ProposedActionOutput",
                            "type": "object"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Existing proposed action, when already calculated."
                      },
                      "outcome": {
                        "anyOf": [
                          {
                            "enum": [
                              "RESOLVED",
                              "RESOLVED_LOW_CONFIDENCE",
                              "AMBIGUOUS",
                              "NEEDS_INFO",
                              "EXHAUSTED",
                              "BLOCKED_POLICY"
                            ],
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Existing closed-set repair outcome, when already assigned."
                      },
                      "touch_count": {
                        "default": 0,
                        "description": "Number of prior human or automation touches.",
                        "minimum": 0,
                        "title": "Touch Count",
                        "type": "integer"
                      },
                      "cycle_time": {
                        "anyOf": [
                          {
                            "minimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Elapsed repair cycle time, when available."
                      }
                    },
                    "required": [
                      "case_id",
                      "rail",
                      "direction",
                      "amount_usd",
                      "currency",
                      "value_date",
                      "cutoff_time",
                      "source_channel",
                      "customer_id",
                      "customer_name",
                      "beneficiary_name",
                      "beneficiary_account",
                      "beneficiary_bank_aba",
                      "remittance_info",
                      "exception_code",
                      "exception_type",
                      "current_queue",
                      "status"
                    ],
                    "title": "PaymentInput",
                    "type": "object",
                    "description": "Typed payment record supplied by the repair queue."
                  }
                }
              },
              {
                "name": "inputs.gate_context",
                "type": "custom",
                "component": "object-editor",
                "label": "gate_context",
                "componentProps": {
                  "schema": {
                    "additionalProperties": false,
                    "properties": {
                      "sanctions_status": {
                        "description": "Current sanctions-screening result for deterministic gate G0.",
                        "enum": [
                          "clear",
                          "review",
                          "match",
                          "unknown"
                        ],
                        "title": "Sanctions Status",
                        "type": "string"
                      },
                      "first_time_counterparty": {
                        "description": "Whether this is the customer's first payment to the counterparty.",
                        "title": "First Time Counterparty",
                        "type": "boolean"
                      },
                      "same_day_beneficiary_total_usd": {
                        "description": "Same-day USD total used by the deterministic velocity gate.",
                        "minimum": 0,
                        "title": "Same Day Beneficiary Total Usd",
                        "type": "number"
                      },
                      "cross_border": {
                        "description": "Whether the payment crosses a national border.",
                        "title": "Cross Border",
                        "type": "boolean"
                      },
                      "evaluated_at": {
                        "description": "ISO-8601 time at which the gate context was evaluated.",
                        "format": "date-time",
                        "title": "Evaluated At",
                        "type": "string"
                      },
                      "cutoff_at": {
                        "description": "ISO-8601 payment-rail cutoff timestamp.",
                        "format": "date-time",
                        "title": "Cutoff At",
                        "type": "string"
                      }
                    },
                    "required": [
                      "sanctions_status",
                      "first_time_counterparty",
                      "same_day_beneficiary_total_usd",
                      "cross_border",
                      "evaluated_at",
                      "cutoff_at"
                    ],
                    "title": "GateContextInput",
                    "type": "object",
                    "description": "Typed context reserved for the separate deterministic gate layer."
                  }
                }
              },
              {
                "name": "inputs.demo_role",
                "type": "text",
                "label": "demo_role"
              }
            ]
          }
        ]
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "payment_case": {
            "additionalProperties": false,
            "properties": {
              "case_id": {
                "description": "Unique wire-repair case identifier.",
                "minLength": 1,
                "title": "Case Id",
                "type": "string"
              },
              "rail": {
                "description": "Payment rail, such as Fedwire.",
                "minLength": 1,
                "title": "Rail",
                "type": "string"
              },
              "direction": {
                "description": "Inbound or outbound payment direction.",
                "enum": [
                  "outbound",
                  "inbound"
                ],
                "title": "Direction",
                "type": "string"
              },
              "amount_usd": {
                "description": "Payment amount normalized to USD.",
                "exclusiveMinimum": 0,
                "title": "Amount Usd",
                "type": "number"
              },
              "currency": {
                "description": "Three-letter ISO currency code on the payment.",
                "pattern": "^[A-Z]{3}$",
                "title": "Currency",
                "type": "string"
              },
              "value_date": {
                "description": "Payment value date in YYYY-MM-DD format.",
                "format": "date",
                "title": "Value Date",
                "type": "string"
              },
              "cutoff_time": {
                "description": "Applicable rail cutoff time in HH:MM format.",
                "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?$",
                "title": "Cutoff Time",
                "type": "string"
              },
              "sla_deadline": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Optional processing SLA deadline."
              },
              "source_channel": {
                "description": "Channel through which the wire originated.",
                "minLength": 1,
                "title": "Source Channel",
                "type": "string"
              },
              "customer_id": {
                "description": "Commercial customer identifier.",
                "minLength": 1,
                "title": "Customer Id",
                "type": "string"
              },
              "customer_name": {
                "description": "Commercial customer display name.",
                "minLength": 1,
                "title": "Customer Name",
                "type": "string"
              },
              "beneficiary_name": {
                "description": "Beneficiary name currently on the wire.",
                "minLength": 1,
                "title": "Beneficiary Name",
                "type": "string"
              },
              "beneficiary_account": {
                "description": "Beneficiary account currently on the wire.",
                "minLength": 1,
                "title": "Beneficiary Account",
                "type": "string"
              },
              "beneficiary_bank_aba": {
                "description": "Beneficiary bank ABA routing number.",
                "minLength": 1,
                "title": "Beneficiary Bank Aba",
                "type": "string"
              },
              "remittance_info": {
                "description": "Wire remittance or invoice information.",
                "title": "Remittance Info",
                "type": "string"
              },
              "exception_code": {
                "description": "Intake exception code requiring repair.",
                "pattern": "^EX-\\d{2}$",
                "title": "Exception Code",
                "type": "string"
              },
              "exception_type": {
                "description": "Human-readable intake exception category.",
                "minLength": 1,
                "title": "Exception Type",
                "type": "string"
              },
              "current_queue": {
                "description": "Current operations queue.",
                "minLength": 1,
                "title": "Current Queue",
                "type": "string"
              },
              "status": {
                "description": "Current payment-processing status.",
                "minLength": 1,
                "title": "Status",
                "type": "string"
              },
              "worked_by": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Current analyst or automation owner."
              },
              "confidence": {
                "anyOf": [
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Existing repair confidence, when already calculated."
              },
              "proposed_action": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "description": "Payment field that the agent proposes changing.",
                        "enum": [
                          "amount_usd",
                          "beneficiary_account",
                          "beneficiary_bank_aba",
                          "beneficiary_name",
                          "currency",
                          "customer_name",
                          "remittance_info"
                        ],
                        "title": "Field",
                        "type": "string"
                      },
                      "current_value": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "description": "Value currently present on the payment.",
                        "title": "Current Value"
                      },
                      "proposed_value": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "description": "Replacement value copied from cited read-only evidence.",
                        "title": "Proposed Value"
                      }
                    },
                    "required": [
                      "field",
                      "current_value",
                      "proposed_value"
                    ],
                    "title": "ProposedActionOutput",
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Existing proposed action, when already calculated."
              },
              "outcome": {
                "anyOf": [
                  {
                    "enum": [
                      "RESOLVED",
                      "RESOLVED_LOW_CONFIDENCE",
                      "AMBIGUOUS",
                      "NEEDS_INFO",
                      "EXHAUSTED",
                      "BLOCKED_POLICY"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Existing closed-set repair outcome, when already assigned."
              },
              "touch_count": {
                "default": 0,
                "description": "Number of prior human or automation touches.",
                "minimum": 0,
                "title": "Touch Count",
                "type": "integer"
              },
              "cycle_time": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Elapsed repair cycle time, when available."
              }
            },
            "required": [
              "case_id",
              "rail",
              "direction",
              "amount_usd",
              "currency",
              "value_date",
              "cutoff_time",
              "source_channel",
              "customer_id",
              "customer_name",
              "beneficiary_name",
              "beneficiary_account",
              "beneficiary_bank_aba",
              "remittance_info",
              "exception_code",
              "exception_type",
              "current_queue",
              "status"
            ],
            "title": "PaymentInput",
            "type": "object",
            "description": "Typed payment record supplied by the repair queue."
          },
          "gate_context": {
            "additionalProperties": false,
            "properties": {
              "sanctions_status": {
                "description": "Current sanctions-screening result for deterministic gate G0.",
                "enum": [
                  "clear",
                  "review",
                  "match",
                  "unknown"
                ],
                "title": "Sanctions Status",
                "type": "string"
              },
              "first_time_counterparty": {
                "description": "Whether this is the customer's first payment to the counterparty.",
                "title": "First Time Counterparty",
                "type": "boolean"
              },
              "same_day_beneficiary_total_usd": {
                "description": "Same-day USD total used by the deterministic velocity gate.",
                "minimum": 0,
                "title": "Same Day Beneficiary Total Usd",
                "type": "number"
              },
              "cross_border": {
                "description": "Whether the payment crosses a national border.",
                "title": "Cross Border",
                "type": "boolean"
              },
              "evaluated_at": {
                "description": "ISO-8601 time at which the gate context was evaluated.",
                "format": "date-time",
                "title": "Evaluated At",
                "type": "string"
              },
              "cutoff_at": {
                "description": "ISO-8601 payment-rail cutoff timestamp.",
                "format": "date-time",
                "title": "Cutoff At",
                "type": "string"
              }
            },
            "required": [
              "sanctions_status",
              "first_time_counterparty",
              "same_day_beneficiary_total_usd",
              "cross_border",
              "evaluated_at",
              "cutoff_at"
            ],
            "title": "GateContextInput",
            "type": "object",
            "description": "Typed context reserved for the separate deterministic gate layer."
          },
          "demo_role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional synthetic role used to organize hackathon demo cases."
          }
        }
      },
      "inputDefaults": {
        "payment_case": null,
        "gate_context": null,
        "demo_role": ""
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "outcome": {
                "description": "Closed-set repair outcome returned to orchestration.",
                "enum": [
                  "RESOLVED",
                  "RESOLVED_LOW_CONFIDENCE",
                  "AMBIGUOUS",
                  "NEEDS_INFO",
                  "EXHAUSTED",
                  "BLOCKED_POLICY"
                ],
                "title": "Outcome",
                "type": "string"
              },
              "proposed_action": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "description": "Payment field that the agent proposes changing.",
                        "enum": [
                          "amount_usd",
                          "beneficiary_account",
                          "beneficiary_bank_aba",
                          "beneficiary_name",
                          "currency",
                          "customer_name",
                          "remittance_info"
                        ],
                        "title": "Field",
                        "type": "string"
                      },
                      "current_value": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "description": "Value currently present on the payment.",
                        "title": "Current Value"
                      },
                      "proposed_value": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "description": "Replacement value copied from cited read-only evidence.",
                        "title": "Proposed Value"
                      }
                    },
                    "required": [
                      "field",
                      "current_value",
                      "proposed_value"
                    ],
                    "title": "ProposedActionOutput",
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Evidence-backed repair proposal, or null when none is supportable.",
                "type": "any"
              },
              "confidence": {
                "description": "Confidence in the proposed repair, between zero and one.",
                "maximum": 1,
                "minimum": 0,
                "title": "Confidence",
                "type": "number"
              },
              "evidence": {
                "description": "Cumulative read-only evidence trace supporting the result.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "case_id": {
                      "description": "Wire-repair case identifier for this evidence.",
                      "minLength": 1,
                      "title": "Case Id",
                      "type": "string"
                    },
                    "type": {
                      "description": "Closed evidence category produced by a read-only source.",
                      "enum": [
                        "lookup",
                        "history_match",
                        "sanctions",
                        "document",
                        "call_transcript"
                      ],
                      "title": "Type",
                      "type": "string"
                    },
                    "source": {
                      "description": "Read-only source URI that produced the evidence.",
                      "minLength": 1,
                      "title": "Source",
                      "type": "string"
                    },
                    "content": {
                      "anyOf": [
                        {
                          "additionalProperties": true,
                          "type": "object"
                        },
                        {
                          "type": "string"
                        }
                      ],
                      "description": "Canonical payload returned by the evidence source.",
                      "title": "Content"
                    },
                    "produced_by": {
                      "description": "Read-only tool that produced this record.",
                      "minLength": 1,
                      "title": "Produced By",
                      "type": "string"
                    },
                    "timestamp": {
                      "description": "ISO-8601 timestamp assigned to the evidence.",
                      "format": "date-time",
                      "title": "Timestamp",
                      "type": "string"
                    }
                  },
                  "required": [
                    "case_id",
                    "type",
                    "source",
                    "content",
                    "produced_by",
                    "timestamp"
                  ],
                  "title": "EvidenceOutput",
                  "type": "object"
                },
                "title": "Evidence",
                "type": "array"
              },
              "reasoning_summary": {
                "description": "Concise explanation of the evidence and control boundary.",
                "title": "Reasoning Summary",
                "type": "string"
              },
              "tools_called": {
                "description": "Read-only tools called, in execution order.",
                "items": {
                  "type": "string"
                },
                "title": "Tools Called",
                "type": "array"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "debug": {
        "runtime": "bpmnEngine"
      }
    },
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.action.script",
      "version": "1.0",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": [
        "code",
        "javascript",
        "python"
      ],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "display": {
        "label": "Script",
        "icon": "code"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "A script function is required",
            "validationSeverity": "warning"
          }
        },
        "required": [
          "script"
        ]
      },
      "inputDefaults": {
        "script": ""
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
      "version": "1.0",
      "category": "human-task",
      "description": "Fast inline approvals with inline debug",
      "tags": [
        "human-task",
        "hitl",
        "human-in-the-loop",
        "quick-form",
        "approval"
      ],
      "sortOrder": 27,
      "display": {
        "label": "Quick Form",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "completed",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:UserTask",
        "serviceType": "Actions.HITL"
      },
      "inputDefaults": {
        "schema": {
          "fields": [],
          "outcomes": [
            {
              "id": "submit",
              "name": "Submit",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        }
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output"
        },
        "status": {
          "type": "string",
          "description": "Task completion status (completed, cancelled, timeout)",
          "source": "=result.Action",
          "var": "status"
        }
      },
      "form": {
        "id": "hitl-quick-form-properties",
        "title": "Quick Form Task Configuration",
        "sections": [
          {
            "id": "delivery",
            "title": "Task Delivery",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.recipient",
                "type": "custom",
                "component": "hitl-channel-selector",
                "label": "Delivery Channels",
                "description": "Select where the task should be sent"
              }
            ]
          },
          {
            "id": "schema",
            "title": "Schema",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.schema",
                "type": "custom",
                "component": "hitl-schema-editor",
                "label": "Task Schema",
                "description": "Define the input and output parameters for this task"
              }
            ]
          },
          {
            "id": "additional-properties",
            "title": "Additional properties",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.title",
                "type": "text",
                "label": "Task title"
              },
              {
                "name": "inputs.priority",
                "type": "select",
                "label": "Priority",
                "options": [
                  {
                    "label": "Low",
                    "value": "Low"
                  },
                  {
                    "label": "Medium",
                    "value": "Medium"
                  },
                  {
                    "label": "High",
                    "value": "High"
                  }
                ]
              },
              {
                "name": "inputs.labels",
                "type": "text",
                "label": "Labels",
                "placeholder": "Comma-separated (e.g. finance,approval)"
              }
            ]
          }
        ]
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    },
    {
      "nodeType": "core.logic.decision",
      "version": "1.0.0",
      "category": "control-flow",
      "description": "Branch based on a true/false condition",
      "tags": [
        "control-flow",
        "if",
        "loop",
        "switch"
      ],
      "sortOrder": 20,
      "display": {
        "label": "Decision",
        "icon": "trending-up-down",
        "iconBackground": "linear-gradient(225deg, #FAFAFB 0%, #ECEDEF 100%)",
        "iconBackgroundDark": "linear-gradient(225deg, #526069 0%, rgba(50, 60, 66, 0.6) 100%)"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "true",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.trueLabel}",
              "constraints": {
                "minConnections": 1
              }
            },
            {
              "id": "false",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.falseLabel}",
              "constraints": {
                "minConnections": 1
              }
            }
          ],
          "visible": true
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:InclusiveGateway"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "A condition expression is required"
          },
          "trueLabel": {
            "type": "string"
          },
          "falseLabel": {
            "type": "string"
          }
        },
        "required": [
          "expression"
        ]
      },
      "outputDefinition": {
        "matchedCase": {
          "type": "string",
          "description": "The label of the matched branch (true/false label)",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "string",
          "description": "The branch that was taken (true or false)",
          "var": "matchedCaseId"
        }
      },
      "inputDefaults": {
        "trueLabel": "True",
        "falseLabel": "False"
      },
      "form": {
        "id": "decision-properties",
        "title": "Decision configuration",
        "sections": [
          {
            "id": "condition",
            "title": "Condition",
            "fields": [
              {
                "name": "inputs.expression",
                "type": "custom",
                "component": "script-editor",
                "componentProps": {
                  "language": "javascript",
                  "returnType": "boolean",
                  "minHeight": 100,
                  "placeholder": "e.g., $vars.data.status === \"approved\" && $vars.data.amount > 1000"
                },
                "label": "Expression",
                "description": "JavaScript expression that evaluates to true or false"
              },
              {
                "name": "inputs.trueLabel",
                "type": "text",
                "label": "True branch label",
                "description": "Label shown when condition is true"
              },
              {
                "name": "inputs.falseLabel",
                "type": "text",
                "label": "False branch label",
                "description": "Label shown when condition is false"
              }
            ]
          }
        ]
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0.0",
      "category": "control-flow",
      "description": "Mark the end of a workflow path",
      "tags": [
        "control-flow",
        "end",
        "finish",
        "complete"
      ],
      "sortOrder": 20,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      }
    }
  ],
