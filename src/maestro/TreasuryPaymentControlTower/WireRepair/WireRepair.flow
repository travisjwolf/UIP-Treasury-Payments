    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
        "id": "repairAgent.output",
        "type": "object",
        "schema": {
          "type": "object",
          "properties": {
            "outcome": {
              "description": "Closed-set repair outcome returned to orchestration.",
              "enum": [
                "RESOLVED",
                "RESOLVED_LOW_CONFIDENCE",
                "AMBIGUOUS",
                "NEEDS_INFO",
                "EXHAUSTED",
                "BLOCKED_POLICY"
              ],
              "title": "Outcome",
              "type": "string"
            },
            "proposed_action": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "description": "Payment field that the agent proposes changing.",
                      "enum": [
                        "amount_usd",
                        "beneficiary_account",
                        "beneficiary_bank_aba",
                        "beneficiary_name",
                        "currency",
                        "customer_name",
                        "remittance_info"
                      ],
                      "title": "Field",
                      "type": "string"
                    },
                    "current_value": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "description": "Value currently present on the payment.",
                      "title": "Current Value"
                    },
                    "proposed_value": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "description": "Replacement value copied from cited read-only evidence.",
                      "title": "Proposed Value"
                    }
                  },
                  "required": [
                    "field",
                    "current_value",
                    "proposed_value"
                  ],
                  "title": "ProposedActionOutput",
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Evidence-backed repair proposal, or null when none is supportable.",
              "type": "any"
            },
            "confidence": {
              "description": "Confidence in the proposed repair, between zero and one.",
              "maximum": 1,
              "minimum": 0,
              "title": "Confidence",
              "type": "number"
            },
            "evidence": {
              "description": "Cumulative read-only evidence trace supporting the result.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "case_id": {
                    "description": "Wire-repair case identifier for this evidence.",
                    "minLength": 1,
                    "title": "Case Id",
                    "type": "string"
                  },
                  "type": {
                    "description": "Closed evidence category produced by a read-only source.",
                    "enum": [
                      "lookup",
                      "history_match",
                      "sanctions",
                      "document",
                      "call_transcript"
                    ],
                    "title": "Type",
                    "type": "string"
                  },
                  "source": {
                    "description": "Read-only source URI that produced the evidence.",
                    "minLength": 1,
                    "title": "Source",
                    "type": "string"
                  },
                  "content": {
                    "anyOf": [
                      {
                        "additionalProperties": true,
                        "type": "object"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "description": "Canonical payload returned by the evidence source.",
                    "title": "Content"
                  },
                  "produced_by": {
                    "description": "Read-only tool that produced this record.",
                    "minLength": 1,
                    "title": "Produced By",
                    "type": "string"
                  },
                  "timestamp": {
                    "description": "ISO-8601 timestamp assigned to the evidence.",
                    "format": "date-time",
                    "title": "Timestamp",
                    "type": "string"
                  }
                },
                "required": [
                  "case_id",
                  "type",
                  "source",
                  "content",
                  "produced_by",
                  "timestamp"
                ],
                "title": "EvidenceOutput",
                "type": "object"
              },
              "title": "Evidence",
              "type": "array"
            },
            "reasoning_summary": {
              "description": "Concise explanation of the evidence and control boundary.",
              "title": "Reasoning Summary",
              "type": "string"
            },
            "tools_called": {
              "description": "Read-only tools called, in execution order.",
              "items": {
                "type": "string"
              },
              "title": "Tools Called",
              "type": "array"
            }
          }
        },
        "binding": {
          "nodeId": "repairAgent",
          "outputId": "output"
        }
      },
      {
        "id": "repairAgent.error",
        "type": "object",
