{
  "id": "827e249b-d372-4aad-b8d7-962c817e5b5f",
  "version": "1.8",
  "name": "WireRepair",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Intake payment"
      },
      "inputs": {
        "entryPointId": "6e82a367-ac19-4fb6-8257-c93c3db5daad",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "repairAgent",
      "type": "core.logic.mock",
      "typeVersion": "1.0",
      "display": {
        "label": "Repair agent proposal"
      },
      "inputs": {}
    },
    {
      "id": "policyGate",
      "type": "core.logic.mock",
      "typeVersion": "1.0",
      "display": {
        "label": "Deterministic policy gate"
      },
      "inputs": {}
    },
    {
      "id": "routeDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Auto-apply eligible?"
      },
      "inputs": {
        "expression": "$vars.start.output.autoApply === true",
        "trueLabel": "Effect",
        "falseLabel": "Human"
      }
    },
    {
      "id": "effectRequest",
      "type": "core.logic.mock",
      "typeVersion": "1.0",
      "display": {
        "label": "Request payment effect"
      },
      "inputs": {}
    },
    {
      "id": "humanEscalation",
      "type": "core.logic.mock",
      "typeVersion": "1.0",
      "display": {
        "label": "Create human escalation"
      },
      "inputs": {}
    },
    {
      "id": "caseLedger",
      "type": "core.logic.mock",
      "typeVersion": "1.0",
      "display": {
        "label": "Append case ledger"
      },
      "inputs": {}
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Complete payment case"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-agent",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "repairAgent",
      "targetPort": "input"
    },
    {
      "id": "edge-agent-gate",
      "sourceNodeId": "repairAgent",
      "sourcePort": "output",
      "targetNodeId": "policyGate",
      "targetPort": "input"
    },
    {
      "id": "edge-gate-route",
      "sourceNodeId": "policyGate",
      "sourcePort": "output",
      "targetNodeId": "routeDecision",
      "targetPort": "input"
    },
    {
      "id": "edge-route-effect",
      "sourceNodeId": "routeDecision",
      "sourcePort": "true",
      "targetNodeId": "effectRequest",
      "targetPort": "input"
    },
    {
      "id": "edge-route-human",
      "sourceNodeId": "routeDecision",
      "sourcePort": "false",
      "targetNodeId": "humanEscalation",
      "targetPort": "input"
    },
    {
      "id": "edge-effect-ledger",
      "sourceNodeId": "effectRequest",
      "sourcePort": "output",
      "targetNodeId": "caseLedger",
      "targetPort": "input"
    },
    {
      "id": "edge-human-ledger",
      "sourceNodeId": "humanEscalation",
      "sourcePort": "output",
      "targetNodeId": "caseLedger",
      "targetPort": "input"
    },
    {
      "id": "edge-ledger-end",
      "sourceNodeId": "caseLedger",
      "sourcePort": "output",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.logic.mock",
      "version": "1.0",
      "category": "control-flow",
      "description": "Placeholder node for prototyping",
      "tags": [
        "blank",
        "todo"
      ],
      "sortOrder": 20,
      "display": {
        "label": "Mock",
        "icon": "square-dashed"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output"
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:Task"
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Mock output value",
          "source": "null",
          "var": "output"
        }
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    },
    {
      "nodeType": "core.logic.decision",
      "version": "1.0.0",
      "category": "control-flow",
      "description": "Branch based on a true/false condition",
      "tags": [
        "control-flow",
        "if",
        "loop",
        "switch"
      ],
      "sortOrder": 20,
      "display": {
        "label": "Decision",
        "icon": "trending-up-down",
        "iconBackground": "linear-gradient(225deg, #FAFAFB 0%, #ECEDEF 100%)",
        "iconBackgroundDark": "linear-gradient(225deg, #526069 0%, rgba(50, 60, 66, 0.6) 100%)"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "true",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.trueLabel}",
              "constraints": {
                "minConnections": 1
              }
            },
            {
              "id": "false",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.falseLabel}",
              "constraints": {
                "minConnections": 1
              }
            }
          ],
          "visible": true
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:InclusiveGateway"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "A condition expression is required"
          },
          "trueLabel": {
            "type": "string"
          },
          "falseLabel": {
            "type": "string"
          }
        },
        "required": [
          "expression"
        ]
      },
      "outputDefinition": {
        "matchedCase": {
          "type": "string",
          "description": "The label of the matched branch (true/false label)",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "string",
          "description": "The branch that was taken (true or false)",
          "var": "matchedCaseId"
        }
      },
      "inputDefaults": {
        "trueLabel": "True",
        "falseLabel": "False"
      },
      "form": {
        "id": "decision-properties",
        "title": "Decision configuration",
        "sections": [
          {
            "id": "condition",
            "title": "Condition",
            "fields": [
              {
                "name": "inputs.expression",
                "type": "custom",
                "component": "script-editor",
                "componentProps": {
                  "language": "javascript",
                  "returnType": "boolean",
                  "minHeight": 100,
                  "placeholder": "e.g., $vars.data.status === \"approved\" && $vars.data.amount > 1000"
                },
                "label": "Expression",
                "description": "JavaScript expression that evaluates to true or false"
              },
              {
                "name": "inputs.trueLabel",
                "type": "text",
                "label": "True branch label",
                "description": "Label shown when condition is true"
              },
              {
                "name": "inputs.falseLabel",
                "type": "text",
                "label": "False branch label",
                "description": "Label shown when condition is false"
              }
            ]
          }
        ]
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0.0",
      "category": "control-flow",
      "description": "Mark the end of a workflow path",
      "tags": [
        "control-flow",
        "end",
        "finish",
        "complete"
      ],
      "sortOrder": 20,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      }
    }
  ],
  "bindings": [],
  "variables": {
    "globals": [
      {
        "id": "autoApply",
        "direction": "in",
        "type": "boolean",
        "defaultValue": false,
        "description": "Deterministic gate result: true only when autonomous application is permitted.",
        "triggerNodeId": "start"
      }
    ],
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
        "id": "repairAgent.output",
        "type": "object",
        "description": "Mock output value",
        "binding": {
          "nodeId": "repairAgent",
          "outputId": "output"
        }
      },
      {
        "id": "policyGate.output",
        "type": "object",
        "description": "Mock output value",
        "binding": {
          "nodeId": "policyGate",
          "outputId": "output"
        }
      },
      {
        "id": "routeDecision.matchedCase",
        "type": "string",
        "description": "The label of the matched branch (true/false label)",
        "binding": {
          "nodeId": "routeDecision",
          "outputId": "matchedCase"
        }
      },
      {
        "id": "routeDecision.matchedCaseId",
        "type": "string",
        "description": "The branch that was taken (true or false)",
        "binding": {
          "nodeId": "routeDecision",
          "outputId": "matchedCaseId"
        }
      },
      {
        "id": "effectRequest.output",
        "type": "object",
        "description": "Mock output value",
        "binding": {
          "nodeId": "effectRequest",
          "outputId": "output"
        }
      },
      {
        "id": "humanEscalation.output",
        "type": "object",
        "description": "Mock output value",
        "binding": {
          "nodeId": "humanEscalation",
          "outputId": "output"
        }
      },
      {
        "id": "caseLedger.output",
        "type": "object",
        "description": "Mock output value",
        "binding": {
          "nodeId": "caseLedger",
          "outputId": "output"
        }
      }
    ],
    "variableUpdates": {}
  },
  "runtime": "maestro",
